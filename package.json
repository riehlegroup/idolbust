{
  "name": "idolbust",
  "type": "module",
  "version": "0.1.0",
  "description": "Simple website software for research projects that want to understand their user needs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "typecheck": "astro check",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css,md,mdx}\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "@astrojs/tailwind": "^6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/builder-vite": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-boundaries": "^5.4.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.6.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    },
    "@boundaries/elements": {
      "handlebars": "4.7.10"
    }
  }
}
