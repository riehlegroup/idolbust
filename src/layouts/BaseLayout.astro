---
import SiteHead from '@/layouts/SiteHead.astro';
import SiteShell from '@/layouts/SiteShell.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  twitterSite?: string;
}

const { title, description, image, twitterSite } = Astro.props;
---

<!doctype html>
<SiteShell>
  <head>
    <SiteHead title={title} description={description} image={image} twitterSite={twitterSite} />
  </head>
  <slot />
</SiteShell>
