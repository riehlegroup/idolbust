---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageIntro } from '@/components/organisms';

const pageTitle = "Solutions";
const pageDescription = "Explore the research support services offered by Idol or Bust.";
const offerings = [
  {
    title: "Discovery",
    body: "We frame the problem space with interviews, lightweight surveys, and stakeholder alignment workshops.",
    href: "/solutions/discovery",
  },
  {
    title: "Synthesis",
    body: "We turn raw observations into decision-ready themes, opportunity maps, and next-step recommendations.",
    href: "/solutions/synthesis",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <PageIntro
      title={pageTitle}
      description="Choose a service track to see how Idol or Bust structures research work from initial discovery through evidence-backed synthesis."
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {offerings.map((offering) => (
        <a
          href={offering.href}
          class="rounded-2xl border border-secondary-200 bg-white p-6 shadow-sm transition-transform transition-colors hover:-translate-y-1 hover:border-primary-300 hover:text-primary-700"
        >
          <h2 class="text-2xl font-semibold text-secondary-900">{offering.title}</h2>
          <p class="mt-3 text-secondary-600">{offering.body}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
