---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AboutTemplate } from '@/components/templates';
import { ABOUT_PAGE_CONTENT, TEAM_MEMBERS } from '@/data/about';
import { BRAND_CONFIG } from '@/data/brand';

const socialLinks = BRAND_CONFIG.links.social;
---

<BaseLayout
  title={ABOUT_PAGE_CONTENT.title}
  description={ABOUT_PAGE_CONTENT.description}
>
  <AboutTemplate
    title={ABOUT_PAGE_CONTENT.title}
    hero={ABOUT_PAGE_CONTENT.hero}
    sections={ABOUT_PAGE_CONTENT.sections}
    teamTitle={ABOUT_PAGE_CONTENT.teamTitle}
    teamMembers={TEAM_MEMBERS}
    socialLabel={ABOUT_PAGE_CONTENT.socialLabel}
    socialLinks={socialLinks}
  />
</BaseLayout>
