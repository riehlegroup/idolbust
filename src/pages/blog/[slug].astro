---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RenderPage from '@/adapters/renderer/RenderPage.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getBlogSlug, getPublishedPosts } from '@/core/utils/blog';
import { blogPostPage } from '@/wiring/blog-post';

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('blog'));
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: getBlogSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const blogPostModel = blogPostPage.toPageModel({
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  author: post.data.author,
  tags: post.data.tags,
  content: Content,
});
---

<BaseLayout title={blogPostModel.title} description={blogPostModel.description}>
  <RenderPage page={blogPostModel} />
</BaseLayout>
