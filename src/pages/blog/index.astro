---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BlogIndexTemplate } from '@/components/templates';
import { getCollection } from 'astro:content';
import { withBase } from "@/components/utils/with-base";
import { formatDate, getBlogSlug, getPublishedPosts, type BlogEntry } from '@/utils/blog';
import { BLOG_PAGE_CONTENT } from '@/data/blog';
import { BRAND_CONFIG } from '@/data/brand';

const posts = getPublishedPosts(await getCollection('blog')).map(
  (post: BlogEntry) => ({
    title: post.data.title,
    description: post.data.description,
    href: withBase(`/blog/${getBlogSlug(post)}/`),
    image: post.data.image?.url,
    imageAlt: post.data.image?.alt,
    dateIso: post.data.pubDate.toISOString(),
    dateLabel: formatDate(post.data.pubDate),
    author: post.data.author,
    tags: post.data.tags,
  })
);
---

<BaseLayout title={BLOG_PAGE_CONTENT.title} description={BRAND_CONFIG.blog.description}>
  <BlogIndexTemplate
    title={BLOG_PAGE_CONTENT.title}
    emptyState={BLOG_PAGE_CONTENT.emptyState}
    posts={posts}
  />
</BaseLayout>
