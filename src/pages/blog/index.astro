---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RenderPage from '@/adapters/renderer/RenderPage.astro';
import { withBase } from '@/adapters/utils/with-base';
import { getBlogSlug, getPublishedPosts } from '@/core/utils/blog';
import { blogPage } from '@/wiring/blog';

const posts = getPublishedPosts(await getCollection('blog'));
const blogListItems = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  href: withBase(`/blog/${getBlogSlug(post)}/`),
  pubDate: post.data.pubDate,
  author: post.data.author,
  tags: post.data.tags,
  imageUrl: post.data.image?.url,
  imageAlt: post.data.image?.alt,
}));
const blogPageModel = blogPage.toPageModel(blogListItems);
---

<BaseLayout title={blogPageModel.title} description={blogPageModel.description}>
  <RenderPage page={blogPageModel} />
</BaseLayout>
