---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RenderPage from "@/adapters/renderer/RenderPage.astro";
import { getPublishedSortedEntries } from "@/core/utils/content";
import { getResourceSlug, type ResourceEntry } from "@/core/utils/resources";
import { withBase } from "@/adapters/utils/with-base";
import { resourcesPage } from "@/wiring/resources";
import { getCollection } from "astro:content";

const resources = getPublishedSortedEntries(await getCollection("resources"));
const resourceItems = resources.map((resource: ResourceEntry) => ({
  title: resource.data.title,
  description: resource.data.description,
  href: withBase(`/resources/${getResourceSlug(resource)}/`),
  category: resource.data.category,
  date: resource.data.updatedDate ?? resource.data.pubDate,
  tags: resource.data.tags,
  imageUrl: resource.data.heroImage,
  imageAlt: resource.data.title,
}));
const resourcesPageModel = resourcesPage.toPageModel(resourceItems);
---

<BaseLayout title={resourcesPageModel.title} description={resourcesPageModel.description}>
  <RenderPage page={resourcesPageModel} />
</BaseLayout>
