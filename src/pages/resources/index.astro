---
import { ResourcesIndexTemplate } from "@/components/templates";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/utils/blog";
import { getPublishedSortedEntries } from "@/utils/content";
import { getResourceSlug, type ResourceEntry } from "@/utils/resources";
import { withBase } from "@/components/utils/with-base";
import { getCollection } from "astro:content";
import { RESOURCES_PAGE_CONTENT } from "@/data/resources";
const resources = getPublishedSortedEntries(await getCollection("resources")).map(
  (resource: ResourceEntry) => ({
    title: resource.data.title,
    description: resource.data.description,
    href: withBase(`/resources/${getResourceSlug(resource)}/`),
    image: resource.data.heroImage,
    imageAlt: resource.data.title,
    category: resource.data.category,
    dateIso: (resource.data.updatedDate ?? resource.data.pubDate).toISOString(),
    dateLabel: formatDate(resource.data.updatedDate ?? resource.data.pubDate),
    tags: resource.data.tags,
  })
);
---

<BaseLayout
  title={RESOURCES_PAGE_CONTENT.title}
  description={RESOURCES_PAGE_CONTENT.description}
>
  <ResourcesIndexTemplate
    title={RESOURCES_PAGE_CONTENT.title}
    description={RESOURCES_PAGE_CONTENT.description}
    emptyState={RESOURCES_PAGE_CONTENT.emptyState}
    resources={resources}
  />
</BaseLayout>
