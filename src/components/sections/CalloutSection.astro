---
import type { CalloutSectionModel } from "@/core/models/section";
import { Button } from "@/components";
import { withBase } from "@/adapters/utils/with-base";

export type Props = CalloutSectionModel;

const { title, body, cta } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="rounded-lg bg-primary-600 p-8 text-center text-white md:p-12">
    <h2 class="text-2xl font-bold md:text-3xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-primary-100">{body}</p>
    {cta && (
      <Button href={withBase(cta.href)} variant="secondary" size="lg" class="mt-6">
        {cta.label}
      </Button>
    )}
  </div>
</section>
