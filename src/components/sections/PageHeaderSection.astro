---
import type { PageHeaderSectionModel } from "@/core/models/section";

export type Props = PageHeaderSectionModel;

const { title, description } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
  <h1 class="mb-3 text-4xl font-bold text-secondary-900">{title}</h1>
  {description && <p class="max-w-2xl text-secondary-600">{description}</p>}
</section>
