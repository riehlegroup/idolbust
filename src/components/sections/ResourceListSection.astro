---
import type { ResourceListSectionModel } from "@/core/models/section";
import { Card } from "@/components";
import { formatDate } from "@/core/utils/blog";

export type Props = ResourceListSectionModel;

const { items, emptyState } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
  {items.length === 0 ? (
    <p class="text-secondary-600">{emptyState}</p>
  ) : (
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {items.map((resource) => (
        <Card
          title={resource.title}
          description={resource.description}
          href={resource.href}
          image={resource.imageUrl}
          imageAlt={resource.imageAlt}
        >
          <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-secondary-500">
            <span class="rounded-full bg-secondary-100 px-2 py-1 text-xs font-medium text-secondary-600">
              {resource.category}
            </span>
            <span>·</span>
            <time datetime={resource.date.toISOString()}>{formatDate(resource.date)}</time>
          </div>
          {resource.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {resource.tags.map((tag) => (
                <span class="rounded-full bg-primary-50 px-2 py-1 text-xs text-primary-700">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </Card>
      ))}
    </div>
  )}
</section>
