---
import type { BlogPostSectionModel } from "@/core/models/section";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

export interface Props extends BlogPostSectionModel {
  content: AstroComponentFactory;
}

const { title, pubDate, author, tags, metaSeparator, content } = Astro.props as Props;
const Content = content;
---

<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
  <header class="mb-8 not-prose">
    <h1 class="text-4xl font-bold text-secondary-900">{title}</h1>
    <div class="mt-4 flex items-center gap-2 text-secondary-600">
      <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}</time>
      <span>{metaSeparator}</span>
      <span>{author}</span>
    </div>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-secondary-100 px-3 py-1 text-sm text-secondary-600">
            {tag}
          </span>
        ))}
      </div>
    )}
  </header>

  <article class="prose prose-secondary">
    <Content />
  </article>
</section>
