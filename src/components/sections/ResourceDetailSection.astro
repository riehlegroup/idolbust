---
import type { ResourceDetailSectionModel } from "@/core/models/section";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

export interface Props extends ResourceDetailSectionModel {
  content: AstroComponentFactory;
}

const {
  category,
  title,
  date,
  showUpdatedLabel,
  updatedLabel,
  tags,
  heroImageSrc,
  heroImageAlt,
  canonicalLabel,
  canonicalUrl,
  relatedTitle,
  related,
  content,
} = Astro.props as Props;
const Content = content;
---

<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
  <header class="mb-8 not-prose">
    <p class="mb-3 inline-flex rounded-full bg-secondary-100 px-3 py-1 text-sm font-medium text-secondary-700">
      {category}
    </p>
    <h1 class="text-4xl font-bold text-secondary-900">{title}</h1>
    <div class="mt-4 flex flex-wrap items-center gap-2 text-secondary-600">
      <time datetime={date.toISOString()}>
        {date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {showUpdatedLabel && <span>{updatedLabel}</span>}
    </div>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-primary-50 px-3 py-1 text-sm text-primary-700">
            #{tag}
          </span>
        ))}
      </div>
    )}
    {heroImageSrc && (
      <img
        src={heroImageSrc}
        alt={heroImageAlt}
        class="mt-6 aspect-video w-full rounded-lg object-cover"
        width="1200"
        height="675"
        loading="lazy"
      />
    )}
  </header>

  <article class="prose prose-secondary">
    <Content />
  </article>

  {(canonicalUrl || related.length > 0) && (
    <section class="mt-12 border-t border-secondary-200 pt-8 not-prose">
      {canonicalUrl && (
        <p class="text-sm text-secondary-600">
          {canonicalLabel}:{" "}
          <a
            class="text-primary-700 hover:text-primary-800"
            href={canonicalUrl}
            rel="noopener noreferrer"
          >
            {canonicalUrl}
          </a>
        </p>
      )}

      {related.length > 0 && (
        <>
          <h2 class="mt-6 text-xl font-semibold text-secondary-900">{relatedTitle}</h2>
          <ul class="mt-3 space-y-2 text-secondary-700">
            {related.map((item) => (
              <li>
                <a class="hover:text-primary-700" href={item.href}>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}
</section>
