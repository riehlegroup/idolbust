---
import type { HeroSectionModel } from "@/core/models/section";
import { Button } from "@/components";
import { withBase } from "@/adapters/utils/with-base";

export type Props = HeroSectionModel;

const { heading, highlight, subheading, primaryCta, secondaryCta } = Astro.props;
const showHighlight = Boolean(highlight);
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="text-center">
    <h1 class="text-4xl font-bold tracking-tight text-secondary-900 sm:text-5xl md:text-6xl">
      {heading}
      {showHighlight && <span class="text-primary-600"> {highlight}</span>}
    </h1>
    {subheading && <p class="mx-auto mt-6 max-w-2xl text-lg text-secondary-600">{subheading}</p>}
    {(primaryCta || secondaryCta) && (
      <div class="mt-8 flex justify-center gap-4">
        {primaryCta && (
          <Button href={withBase(primaryCta.href)} variant="primary" size="lg">
            {primaryCta.label}
          </Button>
        )}
        {secondaryCta && (
          <Button href={withBase(secondaryCta.href)} variant="outline" size="lg">
            {secondaryCta.label}
          </Button>
        )}
      </div>
    )}
  </div>
</section>
